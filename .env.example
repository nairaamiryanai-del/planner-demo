# Включить облачную синхронизацию и push-уведомления (без этого — демо-режим:
# приложение сразу открывается с примерами, данные только в браузере)
VITE_SYNC_ENABLED=true

# Облачная синхронизация и расписание уведомлений (Upstash Redis).
# На Vercel подключается через Marketplace → Upstash, переменные добавятся сами.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Push-уведомления (VAPID). Сгенерировать пару ключей:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Тот же публичный ключ для клиента (попадает в сборку, он не секретный)
VITE_VAPID_PUBLIC_KEY=

# Секрет для «будильщика» /api/tick. Внешний планировщик (например, Upstash QStash)
# вызывает https://<ваш-домен>/api/tick?key=<TICK_SECRET> каждые 5 минут.
TICK_SECRET=
